{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "apps/worker/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "**/dist"
  ]
}
