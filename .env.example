# Fill locally; never commit credentials. Export before running commands.
DATABASE_URL=postgresql://valostudy:REPLACE_LOCAL_PASSWORD@localhost:5432/valostudy
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# OpenAI Plugin Directory domain verification.
# Set this to the exact token generated by the submission portal.
OPENAI_APPS_CHALLENGE=

# Account email verification (Resend).
# RESEND_FROM_EMAIL must use a sender/domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL="VALOSTUDY <auth@example.com>"
# Reachable from both browser and Web/Worker.
# Cloudflare R2: endpoint=https://<ACCOUNT_ID>.r2.cloudflarestorage.com and region=auto.
# Use the S3 Access Key ID / Secret Access Key from Manage R2 API tokens.
# Do not paste the general Cloudflare API token value into S3_ACCESS_KEY.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=valostudy
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Stripe subscription billing.
# Payment Links are public and may be overridden per environment if needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PLUS_PAYMENT_LINK_URL=https://buy.stripe.com/5kQbJ0gR2fp9alR1ow9IQ04
STRIPE_PRO_PAYMENT_LINK_URL=https://buy.stripe.com/cNi6oG58k1yj3Xtd7e9IQ05
